{
  "expo": {
    "name": "Kidscover",
    "slug": "kidscover",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "kidscover",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#5B4BDB",
    "backgroundColor": "#F7F5FF",
    "android": {
      "package": "in.kidscover.app",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B4BDB"
      }
    },
    "ios": {
      "bundleIdentifier": "in.kidscover.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kidscover measures how far each school is from you. Your location is used for that alone and is never saved.",
        "NSFaceIDUsageDescription": "Unlock Kidscover with Face ID instead of typing your password.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kidscover measures how far each school is from you. Your location is used for that alone and is never saved."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Kidscover with Face ID instead of typing your password."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4BDB",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#5B4BDB",
          "dark": {
            "backgroundColor": "#12111F"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5256f914-c7ce-4b29-8b70-86b1586baea9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5256f914-c7ce-4b29-8b70-86b1586baea9"
    },
    "icon": "./assets/icon.png"
  }
}
