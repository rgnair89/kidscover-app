{
  "expo": {
    "name": "Kidscover",
    "slug": "kidscover",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kidscover",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#5B4BDB",
    "backgroundColor": "#F7F5FF",
    "extra": {
      "eas": {
        "projectId": "set-by-eas-init"
      }
    },
    "android": {
      "package": "in.kidscover.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.kidscover.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kidscover measures how far each school is from you. Your location is used for that alone and is never saved.",
        "NSFaceIDUsageDescription": "Unlock Kidscover with Face ID instead of typing your password.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kidscover measures how far each school is from you. Your location is used for that alone and is never saved."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Kidscover with Face ID instead of typing your password."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4BDB"
        }
      ],
      "expo-secure-store"
    ]
  }
}
